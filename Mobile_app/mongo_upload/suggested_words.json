    "word": "പറ",
    "gender": "ഉഭയലിംഗം",
    "root": "പറ",
    "phonetic_transcription": "paṟa",
    "etymology": "സംസ്കൃതത്തിലെ “പൃ” (പറയുക, സംസാരിക്കുക) എന്ന ധാതുവിൽ നിന്നാണ് ഉത്ഭവം.",
    "cultural_note": "“പറ” എന്നത് മലയാളത്തിന്റെ പഴമയിൽ പ്രസംഗവും കലാപരമായ പ്രകടനങ്ങളും സൂചിപ്പിക്കാൻ ഉപയോഗിച്ചിരുന്നു. ചില പ്രദേശങ്ങളിൽ “പറച്ചിൽ” എന്നത് ചടങ്ങുകളിൽ പാട്ടോ കഥാപ്രസംഗമോ സൂചിപ്പിക്കുന്നു.",
    "synonyms": [
      "ചൊല്ല്",
      "വാക്ക്",
      "പ്രസംഗം"
    ],
    "antonyms": [
      "മൗനം",
      "നിശബ്ദം"
    ],
    "dialects": [
      "തെക്കൻ കേരളത്തിൽ “പറ” എന്നത് ചിലപ്പോൾ “കൂവുക” എന്നർത്ഥത്തിലും ഉപയോഗിക്കുന്നു."
    ],
    "inflections": [
      "പറുന്നു",
      "പറഞ്ഞു",
      "പറയും",
      "പറാതിരിക്കുക"
    ],
    "meanings": [
      {
        "meaning": "ധാന്യങ്ങളും ദ്രാവകങ്ങളും അളക്കാനുള്ള ഒരു തോത് (പത്ത് ഇടങ്ങഴി)",
        "context_usage": "ധാന്യങ്ങളും ദ്രാവകങ്ങളും അളക്കാനുള്ള ഒരു തോത് (പത്ത് ഇടങ്ങഴി)"
      },
      {
        "meaning": "നെൽവയലുകളുടെ അളവു നിർണയിക്കുന്ന ഒരു തോത് (ഒരുപറ വിത്തു വിതയ്ക്കാവുന്ന വിസ്താരം. ഉദാഹരണം: പത്തുപറക്കണ്ടം)",
        "context_usage": "നെൽവയലുകളുടെ അളവു നിർണയിക്കുന്ന ഒരു തോത് (ഒരുപറ വിത്തു വിതയ്ക്കാവുന്ന വിസ്താരം. ഉദാഹരണം: പത്തുപറക്കണ്ടം)"
      },
      {
        "meaning": "പറയുക",
        "context_usage": "അവൻ എളുപ്പം പറയും"
      },
      {
        "meaning": "പറക്കുക",
        "context_usage": "പക്ഷി പറന്നു"
      }
    ],
    "proverbs": [
      {
        "proverb": "പറ പറഞ്ഞാൽ പറയും, കേൾക്കാൻ ചെവി വേണം",
        "context_usage": "അവൻ പറയുന്നത് കേൾക്കാതെ തന്നെ കുറ്റപ്പെടുത്തി! പറ പറഞ്ഞാൽ പറയും, കേൾക്കാൻ ചെവി വേണം"
      },
      {
        "proverb": "പറ പറന്ന് പോയി",
        "context_usage": "സമ്മാനത്തിന്റെ കാര്യം പറയാതെ ഇരിക്കാനായിരുന്നു, പക്ഷേ പറ പറന്ന് പോയി"
      }
    ],
