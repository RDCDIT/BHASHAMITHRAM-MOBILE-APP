{
  "expo": {
    "name": "bhashamitram",
    "slug": "bhashamitharam2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bhashamithram-logo.png",
    "scheme": "bhashamitram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bhashamithram-logo.png",
      "bundleIdentifier": "org.cdit.bhashamithram",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bhashamithram-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/bhashamithram-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.cdit.bhashamithram",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bhashamithram-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B2C51",
          "android": {
            "image": "./assets/images/bhashamithram-logo.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-image",
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "322fe8e9-06f7-47c1-8bd1-7aa6d55b68e3"
      }
    },
    "owner": "c-dit"
  }
}
