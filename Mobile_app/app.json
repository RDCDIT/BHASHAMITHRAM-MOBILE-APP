{
  "expo": {
    "name": "bhashamitram",
    "slug": "bhashamitram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bhashamithram-logo.png",
    "scheme": "bhashamitram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bhashamithram-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bhashamithram-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/bhashamithram-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.bhashamitram",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bhashamithram-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B2C51",
          "android": {
            "image": "./assets/images/bhashamithram-logo.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-image",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },  
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a4c78fa-dd18-4bf9-a487-96ada1224c80"
      }
    }
  }
}
