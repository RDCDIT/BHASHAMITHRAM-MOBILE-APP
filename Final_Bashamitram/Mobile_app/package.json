    "expo-doctor": "^1.19.10",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "build:all": "eas build --platform all --profile preview",
    "build:apk": "eas build --platform android --profile preview",
    "build:ipa": "eas build --platform ios --profile preview"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {}
    },
    "autolinking": {
      "exclude": [
        "@expo/dom-webview",
        "@expo/log-box"
      ],
      "buildFromSource": [
        "expo-asset",
        "expo-file-system"
      ]
    }
